Subject: [PATCH 04/20] feat(pricing): WELCOME10 gives 15% during launch week


diff --git a/src/pricing.ts b/src/pricing.ts
index c2b0288..6ebec73 100644
--- a/src/pricing.ts
+++ b/src/pricing.ts
@@ -8,7 +8,7 @@ export interface Discount {
 type Rule = (subtotal: Cents) => Cents;
 
 const rules: Record<string, Rule> = {
-  WELCOME10: (subtotal) => percentOf(subtotal, 10),
+  WELCOME10: (subtotal) => percentOf(subtotal, 15),
   BULK5: (subtotal) => (subtotal >= 5000 ? 500 : 0),
   HALFTEST: (subtotal) => Math.min(percentOf(subtotal, 50), 2000),
 };
