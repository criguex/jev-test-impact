Date: Thu, 3 Sep 2026 09:00:00 +0000
Subject: [PATCH 03/20] refactor(money): extract currency symbols table


diff --git a/src/money.ts b/src/money.ts
index 6915439..3e170d1 100644
--- a/src/money.ts
+++ b/src/money.ts
@@ -4,12 +4,14 @@ export function toCents(amount: number): Cents {
   return Math.round(amount * 100);
 }
 
+const symbols: Record<string, string> = { USD: '$', EUR: '€' };
+
 export function formatMoney(cents: Cents, currency = 'USD'): string {
   const sign = cents < 0 ? '-' : '';
   const absolute = Math.abs(cents);
   const whole = Math.floor(absolute / 100).toLocaleString('en-US');
   const fraction = String(absolute % 100).padStart(2, '0');
-  const symbol = currency === 'EUR' ? '€' : '$';
+  const symbol = symbols[currency] ?? '$';
   return `${sign}${symbol}${whole}.${fraction}`;
 }
 
