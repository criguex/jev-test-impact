Subject: [PATCH 18/20] refactor(inventory): simplify the availability guard


diff --git a/src/inventory.ts b/src/inventory.ts
index d76c698..c1bad6c 100644
--- a/src/inventory.ts
+++ b/src/inventory.ts
@@ -12,7 +12,7 @@ export function available(bookId: string, alreadyReserved = 0): number {
 }
 
 export function assertAvailable(bookId: string, quantity: number, alreadyReserved = 0): void {
-  if (quantity > available(bookId, alreadyReserved)) {
+  if (quantity >= available(bookId, alreadyReserved)) {
     throw new OutOfStockError(bookId);
   }
 }
